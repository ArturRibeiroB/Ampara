{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5433;Database=funeraria;Username=funeraria;Password=funeraria"
  },
  "Tenancy": {
    "DominioBase": "localhost"
  },
  "Database": {
    "AplicarMigrations": true
  },
  "Seed": {
    "Executar": true,
    "Demo": true,
    "AdminEmail": "admin@funeraria.localhost"
  },
  "Email": {
    "Smtp": {
      "Host": "localhost",
      "Porta": 1025,
      "UsarTls": false
    }
  },
  "Identidade": {
    "Links": {
      "UrlDefinirSenha": "http://{slug}.localhost:5173/definir-senha",
      "UrlLogin": "http://{slug}.localhost:5173/login"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  }
}
