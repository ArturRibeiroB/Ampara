{
  "ConnectionStrings": {
    "Database": ""
  },
  "Jwt": {
    "Issuer": "funeraria-api",
    "Audience": "funeraria-web",
    "ChaveAssinatura": "",
    "DuracaoAccessToken": "00:15:00",
    "DuracaoRefreshToken": "7.00:00:00"
  },
  "Tenancy": {
    "DominioBase": "funeraria.app"
  },
  "Database": {
    "AplicarMigrations": false
  },
  "Seed": {
    "Executar": false,
    "Demo": false,
    "AdminEmail": "",
    "AdminSenha": "",
    "AdminNome": "Administrador da plataforma",
    "SenhaDemo": ""
  },
  "Outbox": {
    "Intervalo": "00:00:02",
    "TamanhoLote": 20,
    "MaximoTentativas": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
