# Copie para .env (o .env não vai para o git) e ajuste se precisar.
# Valores SOMENTE para desenvolvimento local. Nunca use estes valores em produção.

# Portas no seu computador. Se o docker compose disser que a porta está ocupada, troque aqui.
POSTGRES_PORTA=5433
API_PORTA=5080
S3_PORTA=8333
REDIS_PORTA=6379
SMTP_PORTA=1025
MAILPIT_PORTA=8025
PGADMIN_PORTA=5050

# Chave de assinatura do JWT da API em container (mínimo 32 caracteres).
JWT_CHAVE_ASSINATURA=chave-local-de-desenvolvimento-troque-se-quiser-0001

# Senhas criadas pelo seed: ADMIN da plataforma (admin@funeraria.localhost)
# e usuários da funerária "demo" (gestor@demo.localhost, funcionario@demo.localhost).
SEED_ADMIN_SENHA=Admin@12345
SEED_SENHA_DEMO=Demo@12345
